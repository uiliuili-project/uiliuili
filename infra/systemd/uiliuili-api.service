[Unit]
Description=uiliuili API
After=network.target postgresql.service

[Service]
Type=simple
User=uiliuili
Group=uiliuili
WorkingDirectory=/opt/uiliuili
EnvironmentFile=-/opt/uiliuili/.env
ExecStart=/usr/bin/node apps/api/dist/main.js
Restart=always
RestartSec=3
# The installer exits with 75 after writing config; restart into full mode.
RestartForceExitStatus=75
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
