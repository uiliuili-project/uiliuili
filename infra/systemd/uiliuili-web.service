[Unit]
Description=uiliuili web (Next.js)
After=network.target uiliuili-api.service

[Service]
Type=simple
User=uiliuili
Group=uiliuili
WorkingDirectory=/opt/uiliuili/apps/web
EnvironmentFile=-/opt/uiliuili/.env
# Run Next.js directly so the service does not depend on a global pnpm shim.
ExecStart=/usr/bin/node /opt/uiliuili/apps/web/node_modules/next/dist/bin/next start -p 3000
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
