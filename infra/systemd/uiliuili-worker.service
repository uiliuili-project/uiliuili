[Unit]
Description=uiliuili worker
After=network.target postgresql.service

[Service]
Type=simple
User=uiliuili
Group=uiliuili
WorkingDirectory=/opt/uiliuili
EnvironmentFile=-/opt/uiliuili/.env
ExecStart=/usr/bin/node apps/worker/dist/main.js
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
