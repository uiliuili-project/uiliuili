# Native installation environment for 萌悠 (MoeYou).
#
# The web installer writes this file for you. For a headless install, copy this
# example to .env and fill in the required values first:
#
#   cp .env.example .env
#   # edit APP_KEY and DATABASE_URL
#   pnpm cli install --from-env
#
# Docker users do not need this file; use docker/.env.example instead.
# Keep .env private (mode 0600) and back it up together with the database.

NODE_ENV=production

# Directory holding .env, config/ and storage/. Defaults to the working directory.
# UILIUILI_ROOT=/opt/uiliuili
# Load .env from a non-default location:
# DOTENV_CONFIG_PATH=/opt/uiliuili/.env

# Public site URL. Use the final scheme, host and port (https in production).
APP_URL=http://localhost:3000
# Internal API URL used by the Next.js server for SSR.
API_INTERNAL_URL=http://127.0.0.1:3001
# Public API base; keep empty for a same-origin deployment.
NEXT_PUBLIC_API_URL=

# Required: PostgreSQL connection string.
# Passwords with special characters must be URL-encoded.
DATABASE_URL=postgres://uiliuili:change-me@127.0.0.1:5432/uiliuili
DB_SCHEMA=uiliuili

# Required: 64 hex characters (32 bytes). Generate with:
#   openssl rand -hex 32
# Never change APP_KEY after installation; encrypted settings depend on it.
APP_KEY=

# Optional. Leave empty for single-node mode.
REDIS_URL=
# Optional. PostgreSQL search is used when empty.
MEILISEARCH_URL=
MEILISEARCH_KEY=

# Optional first-install defaults used by `pnpm cli install --from-env`.
# SITE_NAME=萌悠
# SITE_DESCRIPTION=一个自托管的弹幕视频站
# SITE_TIMEZONE=Asia/Shanghai
# SITE_LOCALE=zh-CN
# SITE_REGISTRATION=open

# Runtime
API_PORT=3001
TRUST_PROXY=false
LOG_LEVEL=info
STORAGE_ROOT=./storage/uploads
# Worker scratch space for transcoding. Defaults to STORAGE_ROOT/tmp.
# WORKER_TEMP_ROOT=./storage/tmp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TRANSCODE_CONCURRENCY=2

# Installer. The API prints the one-time web installer token at startup and
# stores it in storage/install-token.
INSTALL_TOKEN=
# Only enable this for local development. Production installs must provide the
# token even when the browser runs on the server.
INSTALL_ALLOW_LOCALHOST=false

# Optional operations
# UPGRADE_RESTART_CMD=systemctl restart uiliuili-api uiliuili-worker
# GITHUB_REPO=uiliuili-project/uiliuili
