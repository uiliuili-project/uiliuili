# Generated by the uiliuili installer. Do not commit this file.
NODE_ENV=production
# Directory holding .env, config/ and storage/. Defaults to the working directory.
# UILIUILI_ROOT=/opt/uiliuili
APP_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:3001
NEXT_PUBLIC_API_URL=

# PostgreSQL connection string written by the installer.
DATABASE_URL=postgres://uiliuili:change-me@127.0.0.1:5432/uiliuili
DB_SCHEMA=uiliuili

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_KEY=

# Optional. Leave empty for single-node mode.
REDIS_URL=
# Optional. PostgreSQL search is used when empty.
MEILISEARCH_URL=
MEILISEARCH_KEY=

# Runtime
API_PORT=3001
TRUST_PROXY=false
LOG_LEVEL=info
STORAGE_ROOT=./storage/uploads
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TRANSCODE_CONCURRENCY=2

# Installer
INSTALL_TOKEN=
INSTALL_ALLOW_LOCALHOST=true
