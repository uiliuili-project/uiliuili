# Docker Compose deployment example.
#
#   cp docker/.env.example .env
#   # fill in APP_KEY, DB_PASSWORD and ADMIN_PASSWORD
#   docker compose up -d --build
#
# Generate secrets with:
#   openssl rand -hex 32
#   openssl rand -base64 24 | tr '+/' '-_' | tr -d '='
#
# DB_PASSWORD is embedded in a PostgreSQL URL, so keep it URL-safe: letters,
# digits, '-', '_' and '.' only.

COMPOSE_PROJECT_NAME=uiliuili
GATEWAY_PORT=8080

# Public address users open in a browser. Must match the gateway port.
APP_URL=http://localhost:8080

# 64 hex characters (32 bytes). Required, generated on first install.
APP_KEY=

DB_USER=uiliuili
DB_PASSWORD=
DB_NAME=uiliuili
DB_SCHEMA=uiliuili

# Optional. Remove this line to run without Redis.
REDIS_URL=redis://redis:6379

SITE_NAME=uiliuili
SITE_DESCRIPTION=一个自托管的弹幕视频站
SITE_LOCALE=zh-CN
SITE_TIMEZONE=Asia/Shanghai
SITE_REGISTRATION=open

# Created once by the bootstrap container. At least 10 characters with a letter
# and a digit. Change it after the first login.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

INSTALL_LOCALE=zh-CN
INSTALL_DEMO_CONTENT=false

STORAGE_DRIVER=local
TRANSCODE_CONCURRENCY=2
LOG_LEVEL=info

# Optional Meilisearch. Leave empty to use PostgreSQL search.
MEILISEARCH_URL=
MEILISEARCH_KEY=
MEILISEARCH_INDEX_PREFIX=uiliuili

# Optional S3-compatible storage, used only on the first install.
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=uiliuili
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_BASE_URL=
# S3_PREFIX=uiliuili

# Optional SMTP, used only on the first install.
# MAIL_ENABLED=true
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM_NAME=uiliuili
# MAIL_FROM_ADDRESS=noreply@example.com
# MAIL_VERIFICATION_REQUIRED=false
